# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# Any random string; Telegram sends it back on every call so strangers can't hit your webhook
TELEGRAM_WEBHOOK_SECRET=make_up_a_long_random_string
# Meera's chat id(s), comma-separated. Send /start to the bot to see it. Empty = anyone can use the bot.
ALLOWED_CHAT_IDS=

# Gemini — from Google AI Studio (transcription, scoring, keywords; drafts too if no Claude key)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: Claude writes the drafts (holds her voice better). Leave empty to draft with Gemini.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Optional: Supabase memory (notes, drafts, APPROVE/REJECT). Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

SCORE_THRESHOLD=6
